    "n.body" : {
      "comment" : "Corpo. {min} = minuti, {velocita} = km/h, {obiettivo} = passi obiettivo, {mancano} = passi mancanti. Limite: ≤ 140.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst %1$@ min bei %2$@ km/h für %3$@ Schritte (noch %4$@)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You need %1$@ min at %2$@ km/h to reach %3$@ steps (%4$@ left)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitas %1$@ min a %2$@ km/h para alcanzar %3$@ pasos (faltan %4$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il te faut %1$@ min à %2$@ km/h pour atteindre %3$@ pas (il en manque %4$@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti servono %1$@ min a %2$@ km/h per chiudere i %3$@ passi (mancano %4$@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標の%3$@歩まで、あと%4$@歩。%2$@ km/hで%1$@分必要だよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표 %3$@걸음까지 %4$@걸음 남았어요. %2$@ km/h로 %1$@분이 필요해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa de %1$@ min a %2$@ km/h para atingir %3$@ passos (faltam %4$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还差%4$@步即可达到%3$@步。以%2$@ km/h的速度，需要%1$@分钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還差%4$@步即可達到%3$@步。以%2$@ km/h的速度，需要%1$@分鐘。"
          }
        }
      }
    },
    "n.body.jolly" : {
      "comment" : "Corpo della notifica con l'avviso sul Jolly (n.body + n.jolly).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst %1$@ min bei %2$@ km/h für %3$@ Schritte (noch %4$@). Erreichst du dein Ziel nicht, wird heute ein Joker genutzt (%5$@ übrig)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You need %1$@ min at %2$@ km/h to reach %3$@ steps (%4$@ left). Miss your goal tonight and a Joker will be used (%5$@ left)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitas %1$@ min a %2$@ km/h para alcanzar %3$@ pasos (faltan %4$@). Si no alcanzas tu objetivo, esta noche se usará un Comodín (quedarán %5$@)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il te faut %1$@ min à %2$@ km/h pour atteindre %3$@ pas (il en manque %4$@). Sans atteindre ton objectif, un Joker sera utilisé ce soir (il en restera %5$@)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti servono %1$@ min a %2$@ km/h per chiudere i %3$@ passi (mancano %4$@). Se non chiudi, stasera usi un Jolly (ne restano %5$@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標の%3$@歩まで、あと%4$@歩。%2$@ km/hで%1$@分必要だよ。目標未達成なら今夜おまもりを1個使うよ（残り%5$@個）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표 %3$@걸음까지 %4$@걸음 남았어요. %2$@ km/h로 %1$@분이 필요해요. 목표를 달성하지 못하면 오늘 밤 지킴이 1개가 사용돼요. %5$@개가 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa de %1$@ min a %2$@ km/h para atingir %3$@ passos (faltam %4$@). Se não atingir sua meta, um Coringa será usado esta noite (restarão %5$@)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还差%4$@步即可达到%3$@步。以%2$@ km/h的速度，需要%1$@分钟。若未达成目标，今晚将使用1枚护身符（剩余%5$@枚）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還差%4$@步即可達到%3$@步。以%2$@ km/h的速度，需要%1$@分鐘。若未達成目標，今晚將使用1枚護身符（剩餘%5$@枚）。"
          }
        }
      }
    },
    "n.body.lose" : {
      "comment" : "Corpo della notifica con l'avviso sulla serie (n.body + n.lose).",
      "extractionState" : "manual",
      "localizations" : {
