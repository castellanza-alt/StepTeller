    "set.rules.1" : {
      "comment" : "Regola (elenco puntato). Limite: ≤ 110.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Tag zählt, wenn du sein Schrittziel erreichst. Der heutige Tag unterbricht deine Serie nie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A day counts when you reach that day's step goal. Today never breaks your streak."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un día cuenta si alcanzas su objetivo de pasos. El día de hoy nunca rompe tu racha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un jour compte si tu atteins son objectif de pas. Le jour en cours ne rompt jamais ta série."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un giorno è riuscito se i passi raggiungono l'obiettivo di quel giorno. Oggi non rompe mai la streak."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その日の歩数目標に達すれば達成日になります。今日の結果で連続記録が途切れることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해당 날짜의 걸음 수 목표를 달성하면 성공한 날로 인정돼요. 오늘 때문에 연속 기록이 끊기지는 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dia conta se você atingir a meta de passos daquele dia. O dia de hoje nunca quebra a sequência."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "达到当天的步数目标就算达成。当天尚未结束，不会中断连续记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "達到當天的步數目標就算達成。當天尚未結束，不會中斷連續紀錄。"
          }
        }
      }
    },
    "set.rules.2" : {
      "comment" : "Regola. Limite: ≤ 80.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle 15 Tage in Folge am Ziel gibt es 1 Joker. Unbegrenzt sammelbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Earn 1 Joker every 15 days in a row at your goal. No limit on Jokers."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
