          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15일 연속 목표를 달성하면 지킴이 1개를 받아요. 보유 한도는 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
