    "intro.4.p1" : {
      "comment" : "Pagina 4. Paragrafo: cosa dice il promemoria serale. Limite: ≤ 110.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn dein Ziel noch offen ist, siehst du die nötigen Minuten und ob deine Serie in Gefahr ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you haven't reached your goal, it tells you the minutes you need and whether your streak is at risk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aún no alcanzas tu objetivo, te dice cuántos minutos necesitas y si tu racha está en peligro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ton objectif n’est pas atteint, il indique les minutes nécessaires et si ta série est en danger."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l'obiettivo non è chiuso, ti dice quanti minuti ti servono e se la serie è in pericolo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標に届いていないときは、あと何分必要か、連続記録が途切れそうかをお知らせするよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 목표를 달성하지 못했다면, 필요한 시간과 연속 기록이 끊길 위험이 있는지 알려줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ainda não atingiu sua meta, mostra os minutos necessários e se sua sequência está em risco."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标未达成时，告诉你还需多少分钟，以及连续记录是否面临中断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標未達成時，告訴你還需幾分鐘，以及連續紀錄是否可能中斷。"
          }
        }
      }
    },
