          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每连续15天达成目标，可获得1枚护身符。数量无上限。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每連續15天達成目標，可獲得1枚護身符。數量無上限。"
          }
        }
      }
    },
    "set.rules.3" : {
      "comment" : "Regola. Limite: ≤ 150.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verpasst du einen Tag, rettet ein Joker deine Serie automatisch. Sie bleibt gleich. Der Zähler zum nächsten Joker startet wieder bei 0."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miss a day? A Joker saves your streak automatically. It stays the same, and progress toward your next Joker resets to 0."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si fallas un día, un Comodín salva tu racha automáticamente. No aumenta y la cuenta para el próximo Comodín vuelve a 0."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si tu manques un jour, un Joker sauve ta série tout seul. Elle reste sans augmenter. Le compteur du prochain Joker repart de 0."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se manchi un giorno, un Jolly salva la streak da solo: la streak resta, non aumenta e il conto verso il prossimo Jolly riparte da 0."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1日休むと、おまもりが自動で連続記録を守ります。記録はそのままで増えず、次のおまもりまでのカウントは0に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하루를 놓치면 지킴이가 자동으로 연속 기록을 지켜줘요. 기록은 그대로 유지되고 늘어나지 않아요. 다음 지킴이를 받기 위한 일수는 0부터 다시 세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pular um dia, um Coringa salva sua sequência sozinho. Ela não aumenta e a contagem para o próximo Coringa volta a 0."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "漏掉一天时，护身符会自动保护连续记录。记录保留但不增加，距下一枚护身符的累计天数归零。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "漏掉一天時，護身符會自動保護連續紀錄。紀錄保留但不增加，距下一枚護身符的累計天數歸零。"
          }
        }
      }
    },
    "set.rules.4" : {
