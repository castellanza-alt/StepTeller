    "home.edit.message" : {
      "comment" : "Messaggio nella finestrella. «Usa Salute» è il nome del bottone home.useHealth (stessa traduzione, non maiuscola). Limite: ≤ 110.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korrigiere heutige Schritte von Hand. Mit „Health nutzen“ kehrst du zu den Health-Daten zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edit today's steps by hand. Tap “Use Health” to return to Health data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige tus pasos de hoy a mano. Con «Usar Salud» vuelves a los datos de Salud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrige tes pas du jour à la main. « Utiliser Santé » rétablit les données de Santé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Correggi a mano i passi di oggi. Con «Usa Salute» torni ai dati di Salute."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の歩数を手入力で修正。「ヘルスケアを使う」でヘルスケアのデータに戻せるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘 걸음 수를 직접 수정해요. ‘건강 앱 사용’을 누르면 건강 앱의 데이터로 돌아가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Corrija os passos de hoje à mão. “Usar Saúde” volta aos dados do Saúde."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手动修改今日步数。选择“使用健康”可恢复使用“健康”中的数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手動修改今日步數。選擇「使用健康」可恢復使用「健康」中的資料。"
          }
        }
      }
    },
