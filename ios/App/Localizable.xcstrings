    "set.goal.note" : {
      "comment" : "Nota sotto l'obiettivo. «streak» qui = serie (usa il termine del glossario). Limite: ≤ 120.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gilt ab heute. Vergangene Tage behalten ihr damaliges Ziel. Deine Serie bleibt gleich."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Applies from today. Past days keep their original goals, so your streak stays the same."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se aplica desde hoy. Los días anteriores conservan sus objetivos, así que tu racha no cambia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valable dès aujourd’hui. Les jours passés gardent leurs objectifs, donc ta série ne change pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale da oggi. I giorni passati restano valutati con l'obiettivo che avevi allora, quindi la streak non cambia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日から適用されます。過去の日は当時の目標で判定するため、連続記録は変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘부터 적용돼요. 지난 날짜는 당시 목표로 판단하므로 연속 기록은 바뀌지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vale a partir de hoje. Os dias passados mantêm suas metas da época, então sua sequência não muda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从今天起生效。过去的日期仍按当时的目标判断，因此连续记录不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從今天起生效。過去的日期仍依當時的目標判斷，因此連續紀錄不變。"
          }
        }
      }
    },
