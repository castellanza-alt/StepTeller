    "set.reminder.note" : {
      "comment" : "Nota sotto il promemoria. Limite: ≤ 110.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei offenem Ziel: die nötigen Minuten und bei Bedarf ein Hinweis zu deiner Serie oder einem Joker."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your goal isn't reached: the minutes you need, plus a streak or Joker alert if needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no alcanzas tu objetivo: los minutos que necesitas y, si hace falta, un aviso sobre tu racha o un Comodín."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objectif non atteint : les minutes nécessaires et, au besoin, une alerte sur ta série ou un Joker."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l'obiettivo non è chiuso: i minuti che ti servono e, se serve, un avviso sulla streak o sul Jolly."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標未達成なら、必要な時間をお知らせ。連続記録やおまもりの注意点も、必要に応じて表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표 미달성 시 필요한 시간을 알려줘요. 필요하면 연속 기록이나 지킴이에 대한 안내도 보내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se não atingir sua meta: os minutos necessários e, se preciso, um aviso sobre a sequência ou um Coringa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标未达成时，提醒所需分钟数，必要时也会提醒连续记录或护身符的情况。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標未達成時，提醒所需分鐘數，必要時也會提醒連續紀錄或護身符的情況。"
          }
        }
      }
    },
