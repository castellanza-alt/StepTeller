    "w.gallery.desc" : {
      "comment" : "Descrizione nella galleria dei widget. Limite: ≤ 70.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schritte, übrige Minuten und Serie, auch auf dem Sperrbildschirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steps, minutes left and your streak, even on the Lock Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasos, minutos restantes y racha, también en la pantalla de bloqueo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas, minutes restantes et série, même sur l’écran verrouillé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passi, minuti che mancano e serie, anche sul blocco schermo."
          }
