    "intro.1.p1" : {
      "comment" : "Pagina 1. Paragrafo che spiega cosa fa l'app. Limite: ≤ 140.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest deine heutigen Schritte aus Health und zeigt die übrigen Minuten zu Fuß oder auf dem Laufband, in deinem Tempo."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads today's steps from Health and shows how many minutes you have left, walking or on a treadmill, at your speed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee tus pasos de hoy de Salud y te dice cuántos minutos te quedan andando o en la cinta de correr, a tu velocidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit tes pas du jour dans Santé et te dit combien de minutes il te reste à marcher ou à faire sur tapis de course, à ta vitesse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legge i passi di oggi da Salute e ti dice quanti minuti di camminata o di tappeto ti mancano, alla tua velocità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ヘルスケアから今日の歩数を読み取り、設定した速さであと何分歩けばよいかを表示。トレッドミルでも使えるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "건강 앱에서 오늘 걸음 수를 읽고, 선택한 속도로 걷거나 러닝머신을 탈 때 몇 분이 더 필요한지 알려줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lê seus passos de hoje no Saúde e mostra quantos minutos faltam de caminhada ou esteira, na sua velocidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取“健康”中的今日步数，告诉你按所选速度步行或使用跑步机，还需要多少分钟。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讀取「健康」中的今日步數，告訴你依所選速度步行或使用跑步機，還需要幾分鐘。"
          }
        }
      }
    },
    "intro.1.p2" : {
      "comment" : "Pagina 1. Paragrafo su serie e Jolly (vedi glossario). Limite: ≤ 140.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Tag am Ziel verlängert deine Serie. Alle 15 Tage in Folge gibt es einen Joker, der sie bei einem verpassten Tag rettet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each day you reach your goal grows your streak. Every 15 days in a row, you get a Joker to save it if you miss a day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada día que alcanzas tu objetivo alarga tu racha. Cada 15 días seguidos ganas un Comodín, que la salva si te saltas un día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque jour où tu atteins ton objectif prolonge ta série. Tous les 15 jours d’affilée, un Joker la protège si tu manques un jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni giorno a obiettivo allunga la serie. Ogni 15 giorni di fila arriva un Jolly, che la salva se salti un giorno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標達成で連続記録が伸びるよ。15日連続で達成するとおまもりを1つ獲得。1日休んでも記録を守ってくれるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표를 달성할 때마다 연속 기록이 늘어나요. 15일 연속 달성하면 지킴이 하나를 받아요. 하루를 놓쳐도 기록을 지켜줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dia em que atinge sua meta aumenta sua sequência. A cada 15 dias seguidos, ganha um Coringa que a salva se pular um dia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天达成目标，连续记录就会增加。每连续达成15天，可获得一枚护身符。漏掉一天时，它会保护你的连续记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天達成目標，連續紀錄就會增加。每連續達成15天，可獲得一枚護身符。漏掉一天時，它會保護你的連續紀錄。"
          }
        }
      }
    },
