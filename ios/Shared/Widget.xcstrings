    "n.body.lose" : {
      "comment" : "Corpo della notifica con l'avviso sulla serie (n.body + n.lose).",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du brauchst %1$@ min bei %2$@ km/h für %3$@ Schritte (noch %4$@). Ohne Joker endet deine Serie von %5$@ Tagen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You need %1$@ min at %2$@ km/h to reach %3$@ steps (%4$@ left). Without a Joker, your %5$@-day streak ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Necesitas %1$@ min a %2$@ km/h para alcanzar %3$@ pasos (faltan %4$@). Sin Comodines, tu racha de %5$@ días se interrumpe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il te faut %1$@ min à %2$@ km/h pour atteindre %3$@ pas (il en manque %4$@). Sans Joker, ta série de %5$@ jours s’arrête."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti servono %1$@ min a %2$@ km/h per chiudere i %3$@ passi (mancano %4$@). Senza Jolly, la streak di %5$@ giorni si interrompe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目標の%3$@歩まで、あと%4$@歩。%2$@ km/hで%1$@分必要だよ。おまもりがないため、%5$@日間の連続記録が途切れるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목표 %3$@걸음까지 %4$@걸음 남았어요. %2$@ km/h로 %1$@분이 필요해요. 지킴이가 없으면 %5$@일의 연속 기록이 끊겨요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você precisa de %1$@ min a %2$@ km/h para atingir %3$@ passos (faltam %4$@). Sem Coringas, sua sequência de %5$@ dias será interrompida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还差%4$@步即可达到%3$@步。以%2$@ km/h的速度，需要%1$@分钟。没有护身符，%5$@天的连续记录将中断。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "還差%4$@步即可達到%3$@步。以%2$@ km/h的速度，需要%1$@分鐘。沒有護身符，%5$@天的連續紀錄將中斷。"
          }
