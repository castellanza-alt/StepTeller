    "intro.2.note" : {
      "comment" : "Pagina 2. Nota piccola: cosa succede se l'utente nega l'accesso. Limite: ≤ 100.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auch ohne Datenfreigabe funktioniert die App: Gib deine Schritte von Hand ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you don't share your data, the app still works: enter your steps by hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no compartes tus datos, la app sigue funcionando: introduce tus pasos a mano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans partage de données, l’app fonctionne aussi : saisis tes pas à la main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se scegli di non condividerli, l'app funziona lo stesso: inserisci i passi a mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データを共有しなくても大丈夫。歩数を手入力すれば使えるよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터를 공유하지 않아도 괜찮아요. 걸음 수를 직접 입력하면 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se não compartilhar os dados, o app funciona mesmo assim: insira os passos à mão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不共享数据也能使用：手动输入步数就好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不共享資料也能使用：手動輸入步數就好。"
          }
        }
      }
    },
    "intro.2.p1" : {
      "comment" : "Pagina 2. Paragrafo: perché serve l'accesso a Salute. Limite: ≤ 120.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAT liest heutige Schritte und Trainings aus Health, um die Minuten in deinem Tempo zu berechnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAT reads today's steps and your workouts from Health to calculate the minutes at your pace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAT lee tus pasos de hoy y tus entrenamientos de Salud para calcular los minutos a tu ritmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAT lit tes pas du jour et tes entraînements dans Santé pour calculer les minutes à ton allure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAT legge da Salute i passi di oggi e i tuoi allenamenti, per calcolare i minuti alla tua andatura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEATはヘルスケアから今日の歩数とワークアウトを読み取り、あなたのペースで必要な時間を計算するよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAT가 건강 앱에서 오늘 걸음 수와 운동 기록을 읽어, 내 보행 속도에 맞춰 필요한 시간을 계산해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O NEAT lê seus passos de hoje e exercícios no Saúde para calcular os minutos no seu ritmo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAT读取“健康”中的今日步数和体能训练，按你的步速计算所需分钟数。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEAT讀取「健康」中的今日步數和體能訓練，依你的步速計算所需分鐘數。"
          }
        }
      }
    },
    "intro.2.p2" : {
      "comment" : "Pagina 2. Paragrafo: rassicurazione sulla privacy. Limite: ≤ 70.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schreibt nichts. Keine Daten verlassen dein Handy."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It writes nothing. No data leaves your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No escribe nada y ningún dato sale del teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’app n’écrit rien. Aucune donnée ne quitte ton téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non scrive niente e nessun dato esce dal telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き込みはせず、データはスマホの外に送らないよ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 쓰지 않고, 데이터를 휴대폰 밖으로 보내지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não grava nada. Nenhum dado sai do celular."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不写入任何内容，也不向手机外发送数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不寫入任何內容，也不向手機外傳送資料。"
          }
        }
      }
    },
    "intro.2.title" : {
      "comment" : "Pagina 2. Titolo grande, MAIUSCOLO, carattere stretto e spesso. Limite: ≤ 32.",
      "extractionState" : "manual",
