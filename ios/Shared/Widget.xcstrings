          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면에서도 걸음 수, 남은 시간, 연속 기록을 확인해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passos, minutos restantes e sequência, até na Tela Bloqueada."
